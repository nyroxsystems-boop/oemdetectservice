{
  "name": "@partsunion/catalog-scraper",
  "version": "1.0.0",
  "description": "Playwright-based OEM Parts Catalog scraper for PartsLink24",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json && npm run check:dist",
    "check:dist": "node scripts/assert-dist-clean.cjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "start": "node dist/index.js",
    "install:browsers": "npx playwright install chromium"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "pg": "^8.20.0",
    "playwright": "^1.49.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0"
  }
}
