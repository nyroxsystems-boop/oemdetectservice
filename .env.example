# PartsLink24 credentials
PL24_COMPANY_ID=your_company_id
PL24_USERNAME=your_service_account
PL24_PASSWORD=replace_with_real_password

# Server
PORT=4100
NODE_ENV=development
CATALOG_API_KEY=replace_with_at_least_32_random_characters
# Comma-separated browser origins. Leave empty for service-to-service only.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Browser
HEADLESS=true
# Sensitive diagnostic screenshots are opt-in and stored locally with mode 0600.
PARTSLINK_SCREENSHOTS=false

# Rate limiting (ms between requests)
REQUEST_DELAY_MS=3000

# Cache TTL (seconds) — 30 days default
CACHE_TTL_SECONDS=2592000

# Optional export into the WhatsApp bot. Both values are required together.
WWS_BOT_URL=https://bot.example.com
ADMIN_TOKEN=replace_with_at_least_32_random_characters

# Optional persistent OEM PostgreSQL database.
OEM_DATABASE_URL=postgresql://catalog_app:password@db.example.com:5432/oem
# "verify-full" is the secure default. "disable" is accepted only for a
# private/internal hostname such as oem-db or *.railway.internal.
OEM_DATABASE_SSL_MODE=verify-full
# Supply the issuing CA when it is not in the system trust store. Escaped \n is supported.
OEM_DATABASE_SSL_CA=
# Set true when this deployment must not run without OEM PostgreSQL.
OEM_DATABASE_REQUIRED=true
# Development only: explicitly permit SQLite fallback after a configured OEM DB fails.
# This flag never weakens production startup.
OEM_DATABASE_ALLOW_DEGRADED=false

# Bulk crawl safety controls
BULK_DELAY_MS=2000
BULK_MAX_ERRORS=3
